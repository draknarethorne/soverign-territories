{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Likeness Engine Policy",
  "description": "Versioned category hierarchy, score bands, action thresholds, and protection behavior for shared rebase and incremental likeness processing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "status",
    "categoryOrder",
    "scoreBands",
    "categoryAssignmentRules",
    "highCastSimilarityMinimum",
    "castReviewMinimum",
    "photoRouting",
    "identityActions",
    "lookalikeGroups",
    "categoryPolicies",
    "protection"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved"
      ]
    },
    "categoryOrder": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      }
    },
    "scoreBands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "green",
        "yellow",
        "orange",
        "red"
      ],
      "properties": {
        "green": {
          "$ref": "#/definitions/minimumBand"
        },
        "yellow": {
          "$ref": "#/definitions/minimumBand"
        },
        "orange": {
          "$ref": "#/definitions/minimumBand"
        },
        "red": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumExclusive"
          ],
          "properties": {
            "maximumExclusive": {
              "$ref": "#/definitions/score"
            }
          }
        }
      }
    },
    "categoryAssignmentRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/categoryAssignmentRule"
      }
    },
    "highCastSimilarityMinimum": {
      "$ref": "#/definitions/score"
    },
    "castReviewMinimum": {
      "$ref": "#/definitions/score"
    },
    "photoRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewMinimum",
        "automaticRouteMinimum",
        "minimumMargin",
        "minimumOwnCoreLead"
      ],
      "properties": {
        "reviewMinimum": {
          "$ref": "#/definitions/score"
        },
        "automaticRouteMinimum": {
          "$ref": "#/definitions/score"
        },
        "minimumMargin": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "minimumOwnCoreLead": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "identityActions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityClusterMinimumSimilarity",
        "matchReviewMinimum",
        "autoMergeMinimum",
        "autoMergeMinimumMargin",
        "autoMergeMinimumIndependentPhotos",
        "splitReviewMaximum",
        "splitMinimumAlternativeSimilarity",
        "splitMinimumMargin",
        "splitMinimumIndependentPhotos"
      ],
      "properties": {
        "identityClusterMinimumSimilarity": {
          "$ref": "#/definitions/score"
        },
        "matchReviewMinimum": {
          "$ref": "#/definitions/score"
        },
        "autoMergeMinimum": {
          "$ref": "#/definitions/score"
        },
        "autoMergeMinimumMargin": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "autoMergeMinimumIndependentPhotos": {
          "type": "integer",
          "minimum": 2
        },
        "splitReviewMaximum": {
          "$ref": "#/definitions/score"
        },
        "splitMinimumAlternativeSimilarity": {
          "$ref": "#/definitions/score"
        },
        "splitMinimumMargin": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "splitMinimumIndependentPhotos": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "lookalikeGroups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suggestionMinimumSimilarity",
        "automaticAssociationEnabled"
      ],
      "properties": {
        "suggestionMinimumSimilarity": {
          "$ref": "#/definitions/score"
        },
        "automaticAssociationEnabled": {
          "type": "boolean"
        }
      }
    },
    "categoryPolicies": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/categoryPolicy"
      }
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityBlocksAutomaticMoves",
        "photoBlocksAutomaticRemoval",
        "photoBlocksReviewRouting",
        "protectedPhotoMayBeExcludedFromCore"
      ],
      "properties": {
        "identityBlocksAutomaticMoves": {
          "const": true
        },
        "photoBlocksAutomaticRemoval": {
          "const": true
        },
        "photoBlocksReviewRouting": {
          "const": true
        },
        "protectedPhotoMayBeExcludedFromCore": {
          "const": true
        }
      }
    }
  },
  "definitions": {
    "score": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "minimumBand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum"
      ],
      "properties": {
        "minimum": {
          "$ref": "#/definitions/score"
        }
      }
    },
    "categoryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityProtectedByDefault",
        "automaticMergeEnabled",
        "automaticSplitEnabled",
        "automaticPhotoRoutingEnabled",
        "identityCoreMinimumSimilarity",
        "reviewSuggestionBelowSimilarity",
        "splitCandidateBelowSimilarity",
        "minimumUsablePhotosForOutlierActions"
      ],
      "properties": {
        "identityProtectedByDefault": {
          "type": "boolean"
        },
        "automaticMergeEnabled": {
          "type": "boolean"
        },
        "automaticSplitEnabled": {
          "type": "boolean"
        },
        "automaticPhotoRoutingEnabled": {
          "type": "boolean"
        },
        "identityCoreMinimumSimilarity": {
          "$ref": "#/definitions/score"
        },
        "reviewSuggestionBelowSimilarity": {
          "$ref": "#/definitions/score"
        },
        "splitCandidateBelowSimilarity": {
          "$ref": "#/definitions/score"
        },
        "minimumUsablePhotosForOutlierActions": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "categoryAssignmentRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "minimumUsablePhotos"
      ],
      "properties": {
        "category": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "minimumUsablePhotos": {
          "type": "integer",
          "minimum": 1
        },
        "maximumUsablePhotos": {
          "type": "integer",
          "minimum": 1
        },
        "minimumCastSimilarity": {
          "$ref": "#/definitions/score"
        },
        "maximumCastSimilarityExclusive": {
          "$ref": "#/definitions/score"
        }
      }
    }
  }
}
