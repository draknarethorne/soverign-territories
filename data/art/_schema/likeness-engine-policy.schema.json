{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Likeness Engine Policy",
  "description": "Versioned category hierarchy, score bands, action thresholds, and protection behavior for shared rebase and incremental likeness processing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "status",
    "runtimeSettings",
    "categoryOrder",
    "scoreBands",
    "categoryAssignmentRules",
    "highCastSimilarityMinimum",
    "castReviewMinimum",
    "smallGroupCastReviewMinimum",
    "photoRouting",
    "identityActions",
    "lookalikeGroups",
    "categoryPolicies",
    "protection"
  ],
  "properties": {
    "castAdmission": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewMinimum", "minimumIndependentReferences", "approvedClosePairs"],
      "properties": {
        "reviewMinimum": {"type": "number", "minimum": 0, "maximum": 1},
        "minimumIndependentReferences": {"type": "integer", "minimum": 2},
        "approvedClosePairs": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^(Sisters|Angels)/[^/\\\\:]+$"}
          }
        },
        "seedTopCount": {
          "type": "integer", "minimum": 1, "default": 9,
          "description": "Fresh Sandbox rebase only: Sisters/Angels members with the highest own scores kept as seed references no matter what their score is (exempt from red/orange release)."
        },
        "seedReleaseBelow": {
          "type": "number", "minimum": 0, "maximum": 1, "default": 0.6,
          "description": "Fresh Sandbox rebase only: Sisters/Angels members outside the top count and below this own score are released and rescored against the seed."
        }
      }
    },
    "groupCastReviewEnabled": {
      "type": "boolean",
      "default": true,
      "description": "Legacy whole-group cast Review routing and retention mode. False keeps unconfirmed non-cast identities provisional, avoids automatic candidate-group locks and uses individual membership/admission gates; missing retains historical behavior."
    },
    "familyNaming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "description": "Numeric family links independent of score colours: shared surnames are presentation only, never matching evidence.",
      "properties": {
        "enabled": {"type": "boolean"},
        "directCastMinimumSimilarity": {
          "type": "number", "minimum": 0, "maximum": 1, "default": 0.4,
          "description": "Inclusive minimum for a direct identity-to-Angel/Sister link."
        },
        "secondaryMinimumSimilarityExclusive": {
          "type": "number", "minimum": 0, "maximum": 1, "default": 0.35,
          "description": "Exclusive minimum for every secondary identity-to-identity link; chains are allowed."
        },
        "secondarySurnameLinksEnabled": {
          "type": "boolean", "default": true,
          "description": "False permits only direct cast resemblance links to confer surname membership."
        },
        "castSurnameOverrides": {
          "type": "object",
          "description": "User-decided family surnames for fixed Angels/Sisters slots, keyed by slot folder.",
          "propertyNames": {"pattern": "^(Angels|Sisters)/[^/]+$"},
          "additionalProperties": {"type": "string", "pattern": "^[^\\W\\d_][\\w'-]*$"}
        }
      }
    },
    "rebaseProtection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minimumOwnCoreSimilarities"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minimumOwnCoreSimilarities": {
          "type": "object",
          "additionalProperties": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "minProperties": 1
        }
      }
    },
    "smallGroupMaximumUsablePhotos": {"type": "integer", "minimum": 1},
    "runtimeSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mixed", "pool", "minCluster", "odd", "alike", "minFace", "multiFace", "singles", "rematch", "rematchCast", "different", "castMerge"],
      "properties": {
        "mixed": {"$ref": "#/definitions/pathPatterns"},
        "pool": {"$ref": "#/definitions/pathPatterns"},
        "minCluster": {"const": 1},
        "odd": {"$ref": "#/definitions/score"},
        "alike": {"$ref": "#/definitions/score"},
        "minFace": {"type": "integer", "minimum": 1},
        "multiFace": {"$ref": "#/definitions/score"},
        "dominantFaceSecondaryMaximum": {"$ref": "#/definitions/score", "description": "Matching-only gate: a photo may be matched when every other detected face is below this fraction of the main face area; such photos never vote as references. multiFace keeps its reference-eligibility meaning."},
        "singles": {"$ref": "#/definitions/score"},
        "rematch": {"$ref": "#/definitions/score"},
        "rematchCast": {"$ref": "#/definitions/score"},
        "different": {
          "type": "array",
          "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}}
        },
        "castMerge": {"$ref": "#/definitions/score"}
      }
    },
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved"
      ]
    },
    "categoryOrder": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      }
    },
    "scoreBands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "green",
        "yellow",
        "orange",
        "red"
      ],
      "properties": {
        "green": {
          "$ref": "#/definitions/minimumBand"
        },
        "yellow": {
          "$ref": "#/definitions/minimumBand"
        },
        "orange": {
          "$ref": "#/definitions/minimumBand"
        },
        "red": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumExclusive"
          ],
          "properties": {
            "maximumExclusive": {
              "$ref": "#/definitions/score"
            }
          }
        }
      }
    },
    "categoryAssignmentRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/categoryAssignmentRule"
      }
    },
    "highCastSimilarityMinimum": {
      "$ref": "#/definitions/score"
    },
    "castReviewMinimum": {
      "$ref": "#/definitions/score"
    },
    "smallGroupCastReviewMinimum": {
      "$ref": "#/definitions/score"
    },
    "photoRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewMinimum",
        "automaticRouteMinimum",
        "minimumMargin",
        "minimumOwnCoreLead"
      ],
      "properties": {
        "reviewMinimum": {
          "$ref": "#/definitions/score"
        },
        "automaticRouteMinimum": {
          "$ref": "#/definitions/score"
        },
        "minimumMargin": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "minimumOwnCoreLead": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "identityActions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityClusterMinimumSimilarity",
        "matchReviewMinimum",
        "autoMergeMinimum",
        "autoMergeMinimumMargin",
        "autoMergeMinimumIndependentPhotos",
        "splitReviewMaximum",
        "splitMinimumAlternativeSimilarity",
        "splitMinimumMargin",
        "splitMinimumIndependentPhotos"
      ],
      "properties": {
        "identityClusterMinimumSimilarity": {
          "$ref": "#/definitions/score",
          "description": "Legacy/experimental linkage only. SIMPLE new-identity formation is gated by scoreBands (yellow for Potentials, green for five-plus identities); keep this equal to the yellow minimum."
        },
        "independentEvidenceMaximumSimilarity": {
          "$ref": "#/definitions/score"
        },
        "matchReviewMinimum": {
          "$ref": "#/definitions/score"
        },
        "autoMergeMinimum": {
          "$ref": "#/definitions/score"
        },
        "autoMergeMinimumMargin": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "autoMergeMinimumIndependentPhotos": {
          "type": "integer",
          "minimum": 2
        },
        "splitReviewMaximum": {
          "$ref": "#/definitions/score"
        },
        "splitMinimumAlternativeSimilarity": {
          "$ref": "#/definitions/score"
        },
        "splitMinimumMargin": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "splitMinimumIndependentPhotos": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "lookalikeGroups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suggestionMinimumSimilarity",
        "automaticAssociationEnabled"
      ],
      "properties": {
        "associationMaximumSimilarityExclusive": {"$ref": "#/definitions/score"},
        "associationMinimumSimilarity": {"$ref": "#/definitions/score"},
        "minimumIndependentPhotos": {"type": "integer", "minimum": 2},
        "minimumReferenceMargin": {"type": "number", "minimum": 0, "maximum": 1},
        "suggestionMinimumSimilarity": {
          "$ref": "#/definitions/score"
        },
        "automaticAssociationEnabled": {
          "type": "boolean"
        }
      }
    },
    "categoryPolicies": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^(?!(?:Sisters|Angels)$)": {
          "properties": {"galleryAdmissionEnabled": {"const": false}}
        }
      },
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/categoryPolicy"
      }
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityBlocksAutomaticMoves",
        "photoBlocksAutomaticRemoval",
        "photoBlocksReviewRouting",
        "protectedPhotoMayBeExcludedFromCore"
      ],
      "properties": {
        "automatic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "recipeVersion", "minimumOwnCoreSimilarity", "minimumRivalMargin", "minimumIndependentReferences", "minimumEstablishedPhotos"],
          "properties": {
            "enabled": {"type": "boolean"},
            "recipeVersion": {"const": "independent-gallery-loo-v1"},
            "minimumOwnCoreSimilarity": {"type": "number", "minimum": 0, "maximum": 1},
            "minimumRivalMargin": {"type": "number", "minimum": 0, "maximum": 2},
            "minimumIndependentReferences": {"type": "integer", "minimum": 2},
            "minimumEstablishedPhotos": {"type": "integer", "minimum": 3}
          }
        },
        "identityBlocksAutomaticMoves": {
          "const": true
        },
        "photoBlocksAutomaticRemoval": {
          "const": true
        },
        "photoBlocksReviewRouting": {
          "const": true
        },
        "protectedPhotoMayBeExcludedFromCore": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["rebaseProtection"],
        "properties": {
          "rebaseProtection": {"properties": {"enabled": {"const": true}}}
        }
      },
      "then": {
        "properties": {
          "protection": {
            "required": ["automatic"],
            "properties": {
              "automatic": {"properties": {"enabled": {"const": true}}}
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "pathPatterns": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "score": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "minimumBand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum"
      ],
      "properties": {
        "minimum": {
          "$ref": "#/definitions/score"
        }
      }
    },
    "categoryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "photoRouteMinimum",
        "photoRouteMargin",
        "reviewAdmissionEnabled",
        "mergeMinimum",
        "identityProtectedByDefault",
        "automaticMergeEnabled",
        "automaticSplitEnabled",
        "automaticPhotoRoutingEnabled",
        "identityCoreMinimumSimilarity",
        "reviewSuggestionBelowSimilarity",
        "splitCandidateBelowSimilarity",
        "minimumUsablePhotosForOutlierActions"
      ],
      "properties": {
        "photoRouteMinimum": {"$ref": "#/definitions/score"},
        "galleryAdmissionEnabled": {"type": "boolean"},
        "galleryAdmissionMinimumSimilarity": {"type": "number", "minimum": 0, "maximum": 1},
        "unmatchedOutlierSplitEnabled": {"type": "boolean"},
        "photoRouteMargin": {"type": "number", "minimum": 0, "maximum": 2},
        "reviewRouteMinimum": {"$ref": "#/definitions/score"},
        "reviewRouteMargin": {"type": "number", "minimum": 0, "maximum": 2},
        "reviewAdmissionEnabled": {"type": "boolean"},
        "mergeMinimum": {"$ref": "#/definitions/score"},
        "identityProtectedByDefault": {
          "type": "boolean"
        },
        "automaticMergeEnabled": {
          "type": "boolean"
        },
        "automaticSplitEnabled": {
          "type": "boolean"
        },
        "automaticPhotoRoutingEnabled": {
          "type": "boolean"
        },
        "identityCoreMinimumSimilarity": {
          "$ref": "#/definitions/score"
        },
        "reviewSuggestionBelowSimilarity": {
          "$ref": "#/definitions/score"
        },
        "splitCandidateBelowSimilarity": {
          "$ref": "#/definitions/score"
        },
        "minimumUsablePhotosForOutlierActions": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "categoryAssignmentRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "minimumUsablePhotos"
      ],
      "properties": {
        "category": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "minimumUsablePhotos": {
          "type": "integer",
          "minimum": 1
        },
        "maximumUsablePhotos": {
          "type": "integer",
          "minimum": 1
        },
        "minimumCastSimilarity": {
          "$ref": "#/definitions/score"
        },
        "maximumCastSimilarityExclusive": {
          "$ref": "#/definitions/score"
        }
      }
    }
  }
}
