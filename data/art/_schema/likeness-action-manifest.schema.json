{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Likeness Action Manifest",
  "description": "Versioned, user-staged actions exported by the local likeness review gallery. Applying actions requires a separate validating CLI.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "generatedAt", "source", "actions"],
  "properties": {
    "manifestVersion": {"const": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "source": {"const": "people-gallery-review"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {"oneOf": [{"$ref": "#/definitions/action"}, {"$ref": "#/definitions/personAction"}, {"$ref": "#/definitions/renameAction"}]}
    }
  },
  "definitions": {
    "renameAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "personId", "personFolder", "expectedDisplayName", "expectedRecordedName", "expectedTreeSha256", "newName"],
      "properties": {
        "type": {"const": "person-renamed"},
        "personId": {"type": "string", "pattern": "^person_[0-9a-f]{32}$"},
        "personFolder": {"type": "string", "pattern": "^(Angels|Sisters|Models|Prospects|Potentials)/[^/\\\\:]+$"},
        "expectedDisplayName": {"type": "string", "minLength": 1},
        "expectedRecordedName": {"type": "string", "minLength": 1},
        "expectedTreeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "newName": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    },
    "personAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "personId", "personFolder", "expectedProtected"],
      "properties": {
        "type": {"enum": ["person-protected", "person-unprotected"]},
        "personId": {"type": "string", "pattern": "^person_[0-9a-f]{32}$"},
        "personFolder": {"type": "string", "pattern": "^(Models|Prospects)/[^/\\\\:]+$"},
        "expectedProtected": {"type": "boolean"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "photoId", "contentSha256", "sourceBucket", "personFolder"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "anchor-added",
            "anchor-removed",
            "photo-protected",
            "photo-unprotected",
            "sent-to-review",
            "rejected-to-various",
            "match-rejected",
            "review-approved",
            "photo-retired",
            "match-accepted",
            "workflow-photo-selected"
          ]
        },
        "photoId": {"$ref": "#/definitions/photoId"},
        "contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sourceBucket": {"enum": ["Gallery", "Review"]},
        "personFolder": {"$ref": "#/definitions/personFolder"},
        "personId": {"type": "string", "pattern": "^person_[0-9a-f]{32}$"},
        "destinationFolder": {"$ref": "#/definitions/personFolder"},
        "destinationPersonId": {"type": "string", "pattern": "^person_[0-9a-f]{32}$"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"type": {"const": "match-rejected"}},
            "required": ["type"]
          },
          "then": {"required": ["personId"]}
        },
        {
          "if": {
            "properties": {"type": {"const": "match-accepted"}},
            "required": ["type"]
          },
          "then": {"required": ["destinationFolder", "destinationPersonId"]},
          "else": {
            "not": {"anyOf": [{"required": ["destinationFolder"]}, {"required": ["destinationPersonId"]}]}
          }
        },
        {
          "if": {
            "properties": {
              "type": {"enum": ["anchor-added", "anchor-removed", "sent-to-review"]}
            },
            "required": ["type"]
          },
          "then": {"properties": {"sourceBucket": {"const": "Gallery"}}}
        },
        {
          "if": {
            "properties": {"type": {"const": "review-approved"}},
            "required": ["type"]
          },
          "then": {"properties": {"sourceBucket": {"const": "Review"}}}
        },
        {
          "if": {
            "properties": {"type": {"const": "workflow-photo-selected"}},
            "required": ["type"]
          },
          "then": {"properties": {"sourceBucket": {"const": "Gallery"}}}
        }
      ]
    },
    "photoId": {
      "type": "string",
      "pattern": "^photo:(image_[0-9]+|shot_[0-9]{14}|pic_[0-9a-f]{8})$"
    },
    "personFolder": {
      "type": "string",
      "pattern": "^(Angels|Sisters|Models|Prospects|Potentials)/[^/\\\\:]+(/[^/\\\\:]+)?$"
    }
  }
}
