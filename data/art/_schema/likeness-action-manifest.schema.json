{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Likeness Action Manifest",
  "description": "Versioned, user-staged actions exported by the local likeness review gallery. Applying actions requires a separate validating CLI.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "generatedAt", "source", "actions"],
  "properties": {
    "manifestVersion": {"const": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "source": {"const": "people-gallery-review"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/action"}
    }
  },
  "definitions": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "photoId", "contentSha256", "sourceBucket", "personFolder"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "anchor-added",
            "anchor-removed",
            "photo-protected",
            "photo-unprotected",
            "sent-to-review",
            "rejected-to-various",
            "review-approved"
          ]
        },
        "photoId": {"$ref": "#/definitions/photoId"},
        "contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sourceBucket": {"enum": ["Gallery", "Review"]},
        "personFolder": {"$ref": "#/definitions/personFolder"},
        "personId": {"type": "string", "pattern": "^person_[0-9a-f]{32}$"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {"enum": ["anchor-added", "anchor-removed", "sent-to-review"]}
            },
            "required": ["type"]
          },
          "then": {"properties": {"sourceBucket": {"const": "Gallery"}}}
        },
        {
          "if": {
            "properties": {"type": {"const": "review-approved"}},
            "required": ["type"]
          },
          "then": {"properties": {"sourceBucket": {"const": "Review"}}}
        }
      ]
    },
    "photoId": {
      "type": "string",
      "pattern": "^photo:(image_[0-9]+|shot_[0-9]{14}|pic_[0-9a-f]{8})$"
    },
    "personFolder": {
      "type": "string",
      "pattern": "^(Angels|Sisters|Prospects|Potentials)/[^/\\\\:]+(/[^/\\\\:]+)?$"
    }
  }
}
