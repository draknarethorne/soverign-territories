{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline reference rendering request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "batchId", "workspace", "jobs"],
  "properties": {
    "schemaVersion": {"const": 1},
    "batchId": {"$ref": "#/$defs/id"},
    "workspace": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[^<>:\"/\\\\|?*\\u0000-\\u001f]+$"},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "workflowMode", "recipe", "profile", "seed"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "displayName": {"type": "string", "minLength": 1, "maxLength": 100},
          "personId": {"type": "string", "minLength": 1, "maxLength": 100},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "domain"],
            "properties": {
              "path": {"type": "string", "minLength": 1, "maxLength": 500},
              "kind": {"enum": ["photo", "selected-render", "pulled-render"]},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "domain": {"enum": ["general", "artists"]}
            }
          },
          "workflowMode": {"enum": ["reference", "character"]},
          "recipe": {"type": "string", "minLength": 1, "maxLength": 150},
          "profile": {"enum": ["reference-faithful", "slender-fuller-bust", "character-defined"]},
          "seed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
        },
        "allOf": [
          {
            "if": {"properties": {"workflowMode": {"const": "character"}}},
            "then": {"properties": {"profile": {"const": "character-defined"}}},
            "else": {"properties": {"profile": {"enum": ["reference-faithful", "slender-fuller-bust"]}}}
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"}
  }
}
