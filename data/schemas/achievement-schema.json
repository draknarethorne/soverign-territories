{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Achievement Schema",
  "description": "Schema for player achievements and milestones",
  "type": "object",
  "properties": {
    "achievementId": {
      "type": "string",
      "description": "Unique achievement identifier"
    },
    "name": {
      "type": "string",
      "description": "Achievement display name"
    },
    "description": {
      "type": "string",
      "description": "Achievement description"
    },
    "category": {
      "type": "string",
      "enum": ["combat", "collection", "social", "progression", "exploration"],
      "description": "Achievement category"
    },
    "icon": {
      "type": "string",
      "description": "Icon asset path"
    },
    "rarity": {
      "type": "string",
      "enum": ["common", "rare", "epic", "legendary"],
      "description": "Achievement rarity"
    },
    "requirements": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["stat", "action", "collection", "time", "social"],
          "description": "Requirement type"
        },
        "target": {
          "type": "string",
          "description": "Target value or identifier"
        },
        "value": {
          "type": "integer",
          "minimum": 1,
          "description": "Required value to achieve"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "description": "Condition key"
              },
              "operator": {
                "type": "string",
                "enum": ["equals", "greater", "less", "contains"],
                "description": "Comparison operator"
              },
              "value": {
                "type": "string",
                "description": "Condition value"
              }
            }
          },
          "description": "Additional conditions"
        }
      },
      "required": ["type", "value"]
    },
    "rewards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["xp", "card", "resource", "cosmetic", "title"],
            "description": "Reward type"
          },
          "id": {
            "type": "string",
            "description": "Reward identifier"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "description": "Reward amount"
          }
        },
        "required": ["type", "amount"]
      },
      "description": "Achievement rewards"
    },
    "isHidden": {
      "type": "boolean",
      "description": "Whether achievement is hidden until unlocked"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Required achievement IDs"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version"
    }
  },
  "required": ["achievementId", "name", "description", "category", "rarity", "requirements", "rewards", "isHidden", "prerequisites", "schemaVersion"]
}
