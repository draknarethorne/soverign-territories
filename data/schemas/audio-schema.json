{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Audio Schema",
  "description": "Schema for audio assets, music tracks, sound effects, and accessibility features",
  "type": "object",
  "properties": {
    "audioId": {
      "type": "string",
      "description": "Unique audio asset identifier"
    },
    "name": {
      "type": "string",
      "description": "Display name for the audio asset"
    },
    "type": {
      "type": "string",
      "enum": ["music", "sfx", "ambient", "voiceover", "ui"],
      "description": "Audio asset type"
    },
    "category": {
      "type": "string",
      "enum": ["battle", "menu", "map", "expedition", "campaign", "victory", "defeat", "card", "building", "notification"],
      "description": "Audio category for contextual playback"
    },
    "assetPath": {
      "type": "string",
      "description": "Path to audio file (Addressables reference)"
    },
    "duration": {
      "type": "number",
      "description": "Audio duration in seconds"
    },
    "loopable": {
      "type": "boolean",
      "description": "Whether audio should loop"
    },
    "loopPoints": {
      "type": "object",
      "properties": {
        "start": {
          "type": "number",
          "description": "Loop start time in seconds"
        },
        "end": {
          "type": "number",
          "description": "Loop end time in seconds"
        }
      },
      "description": "Seamless loop points for music"
    },
    "volume": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Default volume (0.0 to 1.0)"
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256,
      "description": "Audio priority (0 = highest, 256 = lowest)"
    },
    "fadeIn": {
      "type": "number",
      "description": "Fade in duration in seconds"
    },
    "fadeOut": {
      "type": "number",
      "description": "Fade out duration in seconds"
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "description": "Event that triggers this audio"
          },
          "condition": {
            "type": "object",
            "description": "Optional conditions for playback"
          },
          "delay": {
            "type": "number",
            "description": "Delay before playback in seconds"
          }
        },
        "required": ["event"]
      },
      "description": "Events that trigger audio playback"
    },
    "mixerGroup": {
      "type": "string",
      "enum": ["master", "music", "sfx", "ambient", "ui", "voiceover"],
      "description": "Unity Audio Mixer group"
    },
    "adaptive": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable adaptive music"
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "layerId": {
                "type": "string",
                "description": "Layer identifier"
              },
              "assetPath": {
                "type": "string",
                "description": "Path to layer audio file"
              },
              "condition": {
                "type": "string",
                "description": "Condition for layer activation"
              }
            },
            "required": ["layerId", "assetPath", "condition"]
          },
          "description": "Adaptive music layers (e.g., intensity based on battle state)"
        }
      },
      "description": "Adaptive music configuration"
    },
    "localization": {
      "type": "object",
      "properties": {
        "isLocalized": {
          "type": "boolean",
          "description": "Whether audio has localized versions"
        },
        "variants": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Locale to asset path mapping (e.g., 'en-US': 'path/to/english.mp3')"
        }
      },
      "description": "Localization settings for voiceovers"
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "hasSubtitles": {
          "type": "boolean",
          "description": "Whether subtitles are available"
        },
        "transcriptId": {
          "type": "string",
          "description": "Reference to transcript for screen readers"
        },
        "hapticPattern": {
          "type": "string",
          "description": "Haptic feedback pattern for deaf/hard-of-hearing players"
        },
        "visualCue": {
          "type": "string",
          "description": "Visual indicator when audio plays (e.g., icon, particle effect)"
        }
      },
      "description": "Accessibility features"
    },
    "monetization": {
      "type": "object",
      "properties": {
        "isPremium": {
          "type": "boolean",
          "description": "Whether this is a premium audio asset"
        },
        "unlockMethod": {
          "type": "string",
          "enum": ["default", "vip", "purchase", "achievement", "event"],
          "description": "How to unlock this audio"
        },
        "price": {
          "type": "object",
          "properties": {
            "currency": {
              "type": "string",
              "enum": ["gems", "sovereignTokens"]
            },
            "amount": {
              "type": "integer",
              "minimum": 0
            }
          },
          "description": "Price for premium audio"
        }
      },
      "description": "Monetization settings for premium soundtracks/themes"
    },
    "themeId": {
      "type": "string",
      "description": "Theme association (e.g., 'medieval', 'sci-fi', 'norse')"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for categorization and search"
    },
    "schemaVersion": {
      "type": "integer",
      "description": "Schema version for migrations"
    }
  },
  "required": ["audioId", "name", "type", "assetPath", "mixerGroup", "schemaVersion"],
  "additionalProperties": false
}
