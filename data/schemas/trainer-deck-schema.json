{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Trainer Deck Schema",
  "description": "Pre-constructed 20-card starter decks for onboarding. Curated decks have named Epics + themed synergy. Element decks have random Epics + varied support. Inspired by Pokemon Trainer Decks / Battle Boxes.",
  "type": "object",
  "properties": {
    "deckId": {
      "type": "string",
      "description": "Unique identifier (e.g., 'trainer_flame_warlord', 'trainer_fire_random')",
      "pattern": "^trainer_[a-z_]+$"
    },
    "deckName": {
      "type": "string",
      "description": "Display name (e.g., 'Flame Warlord Deck', 'Fire Element Deck')",
      "maxLength": 50
    },
    "deckType": {
      "type": "string",
      "enum": ["curated", "element"],
      "description": "curated = named Epic + pre-built theme | element = random Epic + varied support"
    },
    "element": {
      "type": "string",
      "enum": ["fire", "water", "earth", "wind", "dark", "light", "neutral"],
      "description": "Primary element theme (fire/water/earth for launch, wind/dark/light for expansion)"
    },
    "guaranteedEpic": {
      "type": "string",
      "description": "Specific card ID for Curated decks (e.g., 'flame_warlord'), 'random' for Element decks",
      "examples": ["flame_warlord", "tidal_guardian", "random"]
    },
    "cardList": {
      "type": "array",
      "description": "Exact 20 cards included in the deck (for Curated) or card pool (for Element)",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "cardId": {
            "type": "string",
            "description": "Card ID from card database (e.g., 'flame_warlord', 'pyromancer')"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "description": "Number of copies (e.g., Pyromancer x2)"
          }
        },
        "required": ["cardId", "quantity"]
      }
    },
    "rarityDistribution": {
      "type": "object",
      "description": "Guaranteed rarity breakdown for Element decks (Curated uses exact cardList)",
      "properties": {
        "epic": {
          "type": "integer",
          "description": "Number of Epic cards (always 1 for Trainer Decks)",
          "enum": [1]
        },
        "rare": {
          "type": "integer",
          "description": "Number of Rare cards (2-4 for Element decks)",
          "minimum": 2,
          "maximum": 4
        },
        "uncommon": {
          "type": "integer",
          "description": "Number of Uncommon cards (6-10 for Element decks)",
          "minimum": 6,
          "maximum": 10
        },
        "common": {
          "type": "integer",
          "description": "Number of Common cards (6-10 for Element decks)",
          "minimum": 6,
          "maximum": 10
        }
      },
      "required": ["epic", "rare", "uncommon", "common"]
    },
    "playstyle": {
      "type": "string",
      "description": "Brief description of deck strategy (e.g., 'Aggressive burn stacking', 'Defensive sustain')",
      "maxLength": 100
    },
    "recommendedFor": {
      "type": "string",
      "description": "Target player archetype (e.g., 'Beginners', 'Aggressive players', 'Replayability')",
      "maxLength": 100
    },
    "previewCards": {
      "type": "array",
      "description": "5 cards shown in selection screen preview",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "string",
        "description": "Card IDs to display in preview (always includes guaranteedEpic)"
      }
    },
    "isPermanentChoice": {
      "type": "boolean",
      "description": "Whether selection is irreversible (true for Trainer Decks)",
      "enum": [true]
    },
    "bonusContent": {
      "type": "object",
      "description": "Additional rewards granted with deck",
      "properties": {
        "boosterPacks": {
          "type": "integer",
          "description": "Number of Standard Booster Packs (5 cards each) given after Trainer Deck reveal",
          "minimum": 0,
          "maximum": 10
        },
        "startingGold": {
          "type": "integer",
          "description": "Bonus gold granted with deck (e.g., 500 for tutorial)",
          "minimum": 0
        }
      }
    },
    "unlockRequirements": {
      "type": "object",
      "description": "Conditions to make deck available (e.g., DLC, events)",
      "properties": {
        "playerLevel": {
          "type": "integer",
          "description": "Minimum player level required (0 = available from start)",
          "minimum": 0
        },
        "isPremium": {
          "type": "boolean",
          "description": "Whether deck requires purchase (false for starter decks)"
        },
        "priceInGold": {
          "type": "integer",
          "description": "Cost in earned gold (0 for free starter decks)",
          "minimum": 0
        },
        "priceInGems": {
          "type": "integer",
          "description": "Cost in premium gems (0 for free starter decks)",
          "minimum": 0
        }
      }
    }
  },
  "required": [
    "deckId",
    "deckName",
    "deckType",
    "element",
    "guaranteedEpic",
    "cardList",
    "playstyle",
    "recommendedFor",
    "previewCards",
    "isPermanentChoice"
  ],
