  "notes": {
    "designPhilosophy": "Trainer Decks model Pokemon TCG Trainer Decks / Battle Boxes: curated synergy for beginners, random variety for replayability. Permanent choice encourages multiple accounts (F2P engagement) and makes choice meaningful.",
    "expansionPath": "Future Game Decks (50 cards, $19.99) can be multi-element (e.g., Norse Deck = Fire + Earth), include 2-3 Epics + 1 Legendary, and offer 'skip RNG' option for collectors.",
    "elementExpansion": "Wind/Dark/Light elements unlock post-launch. New Trainer Decks (e.g., Shadow Assassin Deck) can be added as DLC or earned through campaigns.",
    "rarityBudget": "Trainer Decks bypass rarity budget (pre-validated to be balanced). Game Decks must respect rarity budget (e.g., 50 cards with 2 Epics = 32 points used of 100 point budget)."
  }
}
