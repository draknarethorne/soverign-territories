{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sovereign Territories Card Schema",
  "description": "JSON schema for validating card definitions in the codex",
  "type": "object",
  "required": ["cardId", "collectionNumber", "series", "name", "type", "element", "rarity", "stats"],

  "properties": {
    "cardId": {
      "type": "string",
      "pattern": "^(HERO|UNIT|BUILDING|WORKER|TACTIC|EQUIPMENT)_[A-Z_]+$",
      "description": "Unique identifier (e.g., HERO_ARIA_FLAME_KNIGHT, WORKER_FARMER)"
    },

    "collectionNumber": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}-[0-9]{3}$",
      "description": "Series collection number (e.g., BS-001)"
    },

    "series": {
      "type": "object",
      "required": ["seriesId", "seriesName", "cardNumber", "totalCards"],
      "properties": {
        "seriesId": {"type": "string"},
        "seriesName": {"type": "string"},
        "cardNumber": {"type": "integer", "minimum": 1},
        "totalCards": {"type": "integer", "minimum": 1},
        "releaseDate": {"type": "string", "format": "date"}
      }
    },

    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 50,
      "description": "Human-readable card name (e.g., Aria, Flame Knight)"
    },

    "type": {
      "type": "string",
      "enum": ["Hero", "Unit", "Building", "Worker", "Tactic", "Equipment"],
      "description": "Mechanical card role (extensible; future roles such as Consumable may be added)"
    },

    "archetype": {
      "type": "string",
      "description": "Combat/role differentiation (e.g., Summoner / Spawner, Defense / Tank, Aerial / Flying)"
    },

    "class": {
      "type": "string",
      "description": "Class fantasy (e.g., Necromancer, Paladin, Elder Dragon)"
    },

    "creatureType": {
      "type": "string",
      "description": "Creature taxonomy — canonical values: Humanoid, Dragon, Beast, Elemental, Undead, Construct, Spirit (extensible as new card ideas emerge)"
    },

    "race": {
      "type": "string",
      "description": "Race/lineage (e.g., Dark Elf, Human, n/a)"
    },

    "sex": {
      "type": "string",
      "enum": ["Male", "Female", "None"],
      "description": "Character sex; None for non-character cards"
    },

    "companion": {
      "type": "string",
      "description": "Bonded pet/companion or aligned creature (e.g., Dragon, Reaper, n/a)"
    },

    "pairing": {
      "type": "object",
      "description": "Bonded-pet pairing (Rare+ cards). Pairing a card with its bonded pet transforms the art and grants a bonus; exact mechanics are a Phase 2 decision.",
      "properties": {
        "petCardId": {"type": "string", "description": "cardId of this card's bonded pet (owner side)"},
        "pairsWith": {"type": "string", "description": "cardId of the owner this pet bonds to (pet side)"},
        "pairBonus": {"type": "string", "description": "Description of the pairing bonus (values TBD)"},
        "combinedArtAsset": {"type": "string", "description": "Art shown when the pair is active"}
      }
    },

    "element": {
      "type": "string",
      "enum": ["Darkness", "Fire", "Grass", "Ice", "Water", "Light", "Earth", "Lightning", "Wind", "Poison", "Neutral"],
      "description": "Elemental affiliation (10-element model; Neutral = non-elemental cards)"
    },

    "rarity": {
      "type": "object",
      "required": ["tier", "stars", "points"],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["Basic", "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Transcendent"]
        },
        "stars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "description": "Visual star rating (0-8)"
        },
        "maxStars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "description": "Maximum attainable star rank for this card"
        },
        "points": {
          "type": "integer",
          "enum": [0, 1, 2, 4, 8, 16, 32, 64],
          "description": "Rarity budget cost (Basic = 0, Uncommon = 2, Transcendent = 64)"
        }
      }
    },

    "stats": {
      "type": "object",
      "required": ["health", "mana", "attack", "defense"],
      "properties": {
        "health": {"type": "integer", "minimum": 1, "maximum": 200},
        "mana": {"type": "integer", "minimum": 0, "maximum": 100},
        "attack": {"type": "integer", "minimum": 0, "maximum": 100},
        "defense": {"type": "integer", "minimum": 0, "maximum": 50},
        "moveRange": {"type": "integer", "minimum": 1, "maximum": 8},
        "attackRange": {"type": "integer", "minimum": 1, "maximum": 5},
        "flying": {"type": "boolean"}
      }
    },

    "abilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["abilityId", "name", "type", "description"],
        "properties": {
          "abilityId": {"type": "string", "pattern": "^ABILITY_[A-Z_]+$"},
          "name": {"type": "string"},
          "type": {"type": "string", "enum": ["Active", "Passive"]},
          "manaCost": {"type": "integer", "minimum": 0},
          "cooldown": {"type": "integer", "minimum": 0},
          "usesPerBattle": {"type": "integer", "minimum": 1},
          "description": {"type": "string"}
        }
      }
    },

    "tacticSlots": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8,
      "description": "Number of tactic cards this unit can equip (scales with star rank, up to 8)"
    },

    "lore": {
      "type": "string",
      "description": "Card backstory/flavor text"
    },

    "art": {
      "type": "object",
      "properties": {
        "portraitAsset": {"type": "string"},
        "fullArtAsset": {"type": "string"},
        "shinyPortrait": {"type": "string"},
        "voicelineActor": {"type": "string"}
      }
    },

    "gameplay": {
      "type": "object",
      "properties": {
        "tacticSlots": {"type": "integer"},
        "deckBuildingRules": {
          "type": "object",
          "properties": {
            "maxCopies": {"type": "integer"},
            "uniqueHero": {"type": "boolean"}
          }
        }
      }
    },

    "acquisition": {
      "type": "object",
      "properties": {
        "packSources": {"type": "array", "items": {"type": "string"}},
        "campaignDrops": {"type": "array", "items": {"type": "string"}},
        "dailyLoginRewards": {"type": "array", "items": {"type": "string"}}
      }
    },

    "meta": {
      "type": "object",
      "properties": {
        "designNotes": {"type": "string"},
        "balanceHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {"type": "string", "format": "date"},
              "change": {"type": "string"},
              "author": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
