{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sovereign Territories Card Schema",
  "description": "Authoritative card contract (gameplay + identity). Art DIRECTION (palette, physique, wardrobe, scene recipes) lives in data/art/ and is linked via art.artIdentity -- never duplicated here. Card art OUTPUT is referenced by the *Asset fields in the art block. See docs/working/art-gameplay-reconciliation-oct2026.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cardId", "collectionNumber", "series", "name", "type", "element", "rarity"],

  "allOf": [
    {
      "if": { "required": ["type"], "properties": { "type": { "enum": ["Hero", "Unit"] } } },
      "then": { "required": ["stats"], "properties": { "stats": { "required": ["health", "mana", "attack", "defense"] } } }
    }
  ],

  "properties": {
    "cardId": {
      "type": "string",
      "pattern": "^(HERO|UNIT|BUILDING|WORKER|TACTIC|EQUIPMENT)_[A-Z_]+$",
      "description": "Unique identifier (e.g., HERO_ARIA_FLAME_KNIGHT, WORKER_FARMER)"
    },

    "collectionNumber": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}-[0-9]{3}$",
      "description": "Series collection number (e.g., SD-001)"
    },

    "series": {
      "type": "object",
      "required": ["seriesId", "seriesName", "cardNumber", "totalCards"],
      "properties": {
        "seriesId": {"type": "string"},
        "seriesName": {"type": "string"},
        "cardNumber": {"type": "integer", "minimum": 1},
        "totalCards": {"type": "integer", "minimum": 1},
        "releaseDate": {"type": "string", "format": "date"}
      }
    },

    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 50,
      "description": "Human-readable card name (e.g., Aria, Flame Knight)"
    },

    "type": {
      "type": "string",
      "enum": ["Hero", "Unit", "Building", "Worker", "Tactic", "Equipment"],
      "description": "Mechanical card role (extensible; future roles such as Consumable may be added)"
    },

    "archetype": {
      "type": "string",
      "description": "Combat/role differentiation (e.g., Summoner / Spawner, Defense / Tank, Aerial / Flying)"
    },

    "class": {
      "type": "string",
      "description": "Class fantasy (e.g., Necromancer, Paladin, Elder Dragon)"
    },

    "creatureType": {
      "type": "string",
      "description": "Creature taxonomy — canonical values: Humanoid, Dragon, Beast, Elemental, Undead, Construct, Spirit (extensible as new card ideas emerge)"
    },

    "race": {
      "type": "string",
      "description": "Race/lineage (e.g., Dark Elf, Human, n/a)"
    },

    "sex": {
      "type": "string",
      "enum": ["Male", "Female", "None"],
      "description": "Character sex; None for non-character cards"
    },

    "companion": {
      "type": "string",
      "description": "Bonded pet/companion or aligned creature (e.g., Dragon, Reaper, n/a)"
    },

    "pairing": {
      "type": "object",
      "description": "Bonded-pet pairing (Rare+ cards). Pairing a card with its bonded pet transforms the art and grants a bonus; exact mechanics are a Phase 2 decision.",
      "properties": {
        "petCardId": {"type": "string", "description": "cardId of this card's bonded pet (owner side)"},
        "pairsWith": {"type": "string", "description": "cardId of the owner this pet bonds to (pet side)"},
        "pairBonus": {"type": "string", "description": "Description of the pairing bonus (values TBD)"},
        "combinedArtAsset": {"type": "string", "description": "Art shown when the pair is active"}
      }
    },

    "element": {
      "type": "string",
      "enum": ["Darkness", "Fire", "Grass", "Ice", "Water", "Light", "Earth", "Lightning", "Wind", "Poison", "Neutral"],
      "description": "Elemental affiliation (10-element model; Neutral = non-elemental cards)"
    },

    "rarity": {
      "type": "object",
      "required": ["tier", "stars", "points"],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["Basic", "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Transcendent"]
        },
        "stars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "description": "Visual star rating (0-8)"
        },
        "maxStars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "description": "Maximum attainable star rank for this card"
        },
        "points": {
          "type": "integer",
          "enum": [0, 1, 2, 4, 8, 16, 32, 64],
          "description": "Rarity budget cost (Basic = 0, Uncommon = 2, Transcendent = 64)"
        }
      }
    },

    "stats": {
      "type": "object",
      "properties": {
        "health": {"type": "integer", "minimum": 1, "maximum": 200},
        "mana": {"type": "integer", "minimum": 0, "maximum": 100},
        "attack": {"type": "integer", "minimum": 0, "maximum": 100},
        "defense": {"type": "integer", "minimum": 0, "maximum": 50},
        "moveRange": {"type": "integer", "minimum": 1, "maximum": 8},
        "attackRange": {"type": "integer", "minimum": 1, "maximum": 5},
        "flying": {"type": "boolean"}
      }
    },

    "abilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["abilityId", "name", "type", "description"],
        "properties": {
          "abilityId": {"type": "string", "pattern": "^ABILITY_[A-Z_]+$"},
          "name": {"type": "string"},
          "type": {"type": "string", "enum": ["Active", "Passive"]},
          "manaCost": {"type": "integer", "minimum": 0},
          "cooldown": {"type": "integer", "minimum": 0},
          "usesPerBattle": {"type": "integer", "minimum": 1},
          "description": {"type": "string"}
        }
      }
    },

    "tacticSlots": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8,
      "description": "Number of tactic cards this unit can equip (scales with star rank, up to 8)"
    },

    "lore": {
      "type": "string",
      "description": "Card backstory/flavor text"
    },

    "art": {
      "type": "object",
      "description": "The card's link to its art. artIdentity points at the art-direction file (data/art/heroes|dragons/**), whose cardId must point back here. The *Asset fields reference rendered output consumed by the client. Art-direction attributes (palette, physique, hair, wardrobe) must NOT be added here -- they belong to the art identity file.",
      "additionalProperties": false,
      "properties": {
        "artIdentity": {
          "type": "string",
          "pattern": "^data/art/(heroes|dragons)/.+\\.json$",
          "description": "Repo-relative path to this card's art identity file"
        },
        "portraitAsset": {"type": "string", "description": "Rendered portrait/head image reference"},
        "fullArtAsset": {"type": "string", "description": "Rendered full card art (signature scene) reference"},
        "variants": {
          "type": "array",
          "description": "Art editions of this card (finishes defined in data/art/_schema/finishes.json). A variant never changes gameplay; its code is <collectionNumber>-<suffix>, e.g. SD-001-HOLO.",
          "items": {
            "type": "object",
            "required": ["finish", "artCard"],
            "additionalProperties": false,
            "properties": {
              "finish": {"type": "string", "pattern": "^[a-z]+$", "description": "Key in finishes.json"},
              "title": {"type": "string", "description": "Edition title shown with the card, e.g. Reaper Queen (authored finishes such as holo)"},
              "artCard": {"type": "string", "pattern": "^data/art/_sets/.+\\.json$", "description": "The scene card that produces this edition; it must carry the same finish"},
              "fullArtAsset": {"type": "string", "description": "Rendered full card art reference"},
              "videoAsset": {"type": "string", "description": "Rendered animated art reference"}
            }
          }
        },
        "voicelineActor": {"type": "string"}
      }
    },

    "equipSlot": {
      "type": "string",
      "enum": ["Weapon", "Armor", "Helmet", "Shield", "Accessory"],
      "description": "Equipment cards: which slot the item occupies"
    },

    "manaCost": {"type": "integer", "minimum": 0, "description": "Tactic cards: mana to play"},

    "effect": {
      "type": "object",
      "description": "Tactic cards: the authored effect",
      "required": ["type", "description"],
      "properties": {
        "type": {"type": "string"},
        "description": {"type": "string"}
      }
    },

    "resourceType": {
      "type": "string",
      "enum": ["Food", "Lumber", "Ore", "Gold"],
      "description": "Worker/Building cards: the resource produced (Phase 2 economy)"
    },

    "gameplay": {
      "type": "object",
      "properties": {
        "tacticSlots": {"type": "integer"},
        "deckBuildingRules": {
          "type": "object",
          "properties": {
            "maxCopies": {"type": "integer"},
            "uniqueHero": {"type": "boolean"}
          }
        }
      }
    },

    "acquisition": {
      "type": "object",
      "properties": {
        "packSources": {"type": "array", "items": {"type": "string"}},
        "campaignDrops": {"type": "array", "items": {"type": "string"}},
        "dailyLoginRewards": {"type": "array", "items": {"type": "string"}}
      }
    },

    "meta": {
      "type": "object",
      "properties": {
        "designNotes": {"type": "string"},
        "balanceHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {"type": "string", "format": "date"},
              "change": {"type": "string"},
              "author": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
