    "uat": [
      {"groups": ["angel-primes"], "workspace": "Angel Primes"},
      {"groups": ["drakn-bound"], "workspace": "Drakn Bound"},
      {"groups": ["elder-dragons"], "workspace": "Elder Dragons"},
