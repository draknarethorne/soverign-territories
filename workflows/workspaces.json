  "workspaces": {
    "Sovereign Territories": {
      "output": "Sovereign Territories",
      "status": "active",
      "templates": true,
      "accepts": ["*"],
      "role": "HOME of the art and brand set (the sovereign-territories set: title, logo, icons, key art, plates) and the ST stage templates. Also takes any other set on request, for a while: promotional videos for reels and feeds, a scene kept next to the art, media for posts. Deploy it there with -w, remove it with cleanup -w when you are done; the set keeps its own home."
    },
    "Drakness": {
      "output": "Sovereign Territories",
      "status": "active",
      "legacy": true,
      "pull": false,
      "role": "HOME (second copy): Drakness's own workspace beside Drakn Sisters, for working through issues with zz_Shots, zz_Curated and test items without polluting the shared workspace. Kept in sync on purpose; still holds her original hand-made experiments. The other sisters have no workspace of their own; add one only while you need it."
    },
    "Angel Primes": {
      "output": "Angel Primes",
      "status": "active",
      "role": "HOME: the clean test bed, twenty angels (ten female, ten male) on a good-to-evil spectrum, each with a bonded pet. Try new things here first (themes, backgrounds, creatures, clothing, weapons, motions) and pull only what works into the Drakn workspaces. It never produces final artwork. Angelica and Angelo are the older pair."
    },
    "Drakn Sisters": {
      "output": "Sovereign Territories",
      "status": "active",
      "role": "HOME: the whole image pipeline for all ten sisters, laid out hero first and by pipeline phase (Hero/1_Alpha ... 7_Video, Bench), so each sister's folder reads like the process. Final art is made here; zz_Shots, zz_Curated and zz_Test are mastered here."
    },
    "Drakn Bound": {"output": "Sovereign Territories", "status": "planned", "role": "HOME (planned): one workspace for all ten bound heroes, studio and scenes, laid out like Drakn Sisters. Skipped by every command until its status is active."},
    "Elder Dragons": {"output": "Sovereign Territories", "status": "planned", "role": "HOME (planned): one workspace for the ten Elder Dragons (text-to-image plates, heads and lairs). Skipped by every command until its status is active."},
    "Sovereign Dawn Series": {
      "output": "Sovereign Dawn Series",
      "status": "active",
      "accepts": ["drakn-sisters", "drakn-bound", "elder-dragons"],
      "role": "HOME of the Sovereign Dawn card set (units, pets, buildings, equipment, tactics, workers). Drakn Sisters, Drakn Bound and Elder Dragons can also be put here on request (deploy -w), as a temporary copy that cleanup -w removes."
    }
  },
  "homes": [
    {"groups": ["sovereign-territories"], "workspace": "Sovereign Territories"},
    {"groups": ["sovereign-dawn"], "workspace": "Sovereign Dawn Series"},
    {"groups": ["angel-primes"], "workspace": "Angel Primes"},
