  "engines": {
    "firered": {
      "template": "workflows/_templates/ST3_FireRed_Final.json",
      "turbo": true,
      "dir": "workflows/.test/firered",
      "classes": ["scene"],
      "fxScenes": "*",
      "envFirst": ["Signature"],
      "fx": "Magic and spell effects: first render every physical effect realistically, with real-world behaviour and texture - real fire, real smoke, real sparks, dust, spray and mist - then layer the magic on top of it: the same smoke, flames and particles also glow from within with luminous light in the colour of her magic, with bright cores, arcs of energy, glowing runes, strong bloom and a subtle lens flare. A spell forming in her hand is a real, tangible presence (swirling, dense, physical) that is also radiantly lit and vivid, like the visual effects of a big-budget fantasy film. The magic light must visibly illuminate and colour her skin, gown, hair and the surroundings. Keep the person, clothing, skin and environment photographic and lifelike."
    },
    "minimax": {
      "template": "workflows/_templates/ST6_MiniMax_Video.json",
      "turbo": true,
      "dir": "workflows",
      "classes": ["scene"]
    }
  },
