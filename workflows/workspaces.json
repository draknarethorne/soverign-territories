  "dev": ["Sovereign Territories"],
  "workspaces": {
    "Sovereign Territories": {"output": "Sovereign Territories", 
      "status": "active",
      "templates": true,
      "role": "DEV: build and prove workflows, ideation and mass changes; holds the ST stage templates. Default deploy target."
    },
    "Drakness": {"output": "Sovereign Territories", 
      "status": "active",
      "legacy": true,
      "pull": false,
      "role": "UAT: her own workspace, kept in sync with Drakn Sisters. Still holds the original hand-made experiments until her armor, clothing and scenes are covered by the generated set. The other sisters have no workspace of their own; add one only while you need it."
    },
    "Angel Primes": {"output": "Angel Primes", 
      "status": "planned",
      "role": "UAT: the clean test bed, twenty angels (ten female, ten male) on a good-to-evil spectrum, each with a bonded pet. Try new things here first (themes, backgrounds, creatures, clothing, weapons, motions) and pull only what works into the Drakn workspaces. It never produces production artifacts. Angelica and Angelo are the older pair."
    },
    "Drakn Sisters": {"output": "Sovereign Territories", 
      "status": "active",
      "role": "UAT: the workspace for all ten sisters, laid out hero first and by pipeline phase (Hero/1_Alpha ... 7_Video, Bench), so each sister's folder reads like the process."
    },
    "Drakn Bound": {"output": "Sovereign Territories", "status": "planned", "role": "UAT: one workspace for all ten bound heroes, studio and scenes, laid out like Drakn Sisters."},
    "Elder Dragons": {"output": "Sovereign Territories", "status": "planned", "role": "UAT: one workspace for the ten Elder Dragons (text-to-image plates, heads and lairs)."},
    "Sovereign Dawn Series": {"output": "Sovereign Dawn Series", 
      "status": "planned",
      "role": "PROD: the final art and polish for the actual cards of the Sovereign Dawn series, all tiers."
    }
  },
