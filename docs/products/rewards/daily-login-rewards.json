  "totalWeeklyRewards": {
    "gold": 1400,
    "gems": 75,
    "packs": {
      "standard-pack": 1,
      "rare-pack": 1
    }
  },
  "missedDayBehavior": {
    "counterResets": false,
    "description": "If player misses a day, they remain on current day number. Next login continues from where they left off. This encourages consistency without punishing breaks.",
    "example": "Player logs in Day 1, 2, 3, skips a week, comes back → still on Day 4 (does NOT reset to Day 1)"
  },
  "implementation": {
    "nakamaStorage": {
      "collection": "player_daily_login",
      "key": "current_day",
      "value": "1-7",
      "lastLoginTimestamp": "unix_timestamp"
    },
    "rewardClaim": {
      "autoGrantOnLogin": true,
      "requiresUIConfirmation": false,
      "description": "Rewards granted automatically on login, shown in popup UI"
    }
  },
  "f2pBalance": {
    "goldPerWeek": 1400,
    "packsPerWeek": 2,
    "monthlyValue": {
      "gold": 6000,
      "packs": 8,
      "equivalentRealMoney": "$7.92 (8 packs × $0.99)"
    },
    "description": "F2P players earn ~6,000 Gold/month from dailies alone, enough for 6 Standard Packs. Combined with quest rewards (500 Gold/day = 15,000 Gold/month), F2P earns 21,000 Gold/month = 21 Standard Packs."
