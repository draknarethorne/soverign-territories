{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Card",
  "type": "object",
  "required": ["id","name","type","rarity","level","stats","schemaVersion"],
  "properties": {
    "id": {"type":"string"},
    "name": {"type":"string"},
    "type": {"type":"string","enum":["hero","unit","building","tactic","equipment"]},
    "rarity": {"type":"string","enum":["common","rare","epic","legendary"]},
    "level": {"type":"integer","minimum":1},
    "xp": {"type":"integer","minimum":0},
    "stats": {
      "type":"object",
      "properties":{
        "attack":{"type":"number"},
        "defense":{"type":"number"},
        "hp":{"type":"number"},
        "speed":{"type":"number"}
      },
      "required":["attack","defense","hp","speed"]
    },
    "element": {"type":"string","enum":["fire","water","earth","air","none"]},
    "abilities": {"type":"array","items":{"type":"string"}},
    "sockets": {"type":"array","items":{"type":"string"}},
    "stackSize": {"type":"integer","minimum":1},
    "production": {"type":"object"},
    "visual": {"type":"string"},
    "deployConstraints": {"type":"array","items":{"type":"string"}},
    "attackType": {"type":"string","enum":["melee","ranged","aoe","piercing"]},
    "attackRange": {"type":"integer","minimum":0},
    "attackSpeed": {"type":"number"},
    "aoeRadius": {"type":"integer","minimum":0},
    "projectileSpeed": {"type":"number"},
    "ammo": {"oneOf":[{"type":"integer"},{"type":"null"}]},
    "moveRange": {"type":"integer","minimum":0},
    "moveType": {"type":"string","enum":["walk","fly","teleport","swim"]},
    "movementCostModifiers": {"type":"object","additionalProperties":{"type":"number"}},
    "visionRange": {"type":"integer","minimum":0},
    "stealth": {"oneOf":[{"type":"boolean"},{"type":"number"}]},
    "detectRange": {"type":"integer","minimum":0},
    "resistances": {"type":"object","additionalProperties":{"type":"number"}},
    "vulnerabilities": {"type":"object","additionalProperties":{"type":"number"}},
    "critChance": {"type":"number","minimum":0,"maximum":1},
    "critMultiplier": {"type":"number","minimum":1},
    "evasion": {"type":"number","minimum":0,"maximum":1},
    "block": {"type":"number"},
    "statusImmunities": {"type":"array","items":{"type":"string"}},
    "cooldowns": {"type":"object","additionalProperties":{"type":"integer"}},
    "aiTags": {"type":"array","items":{"type":"string"}},
    "targetingPriority": {"type":"array","items":{"type":"string"}},
    "deployCost": {"type":"object"},
    "upkeep": {"type":"object"},
    "durability": {"type":"number"},
    "buildTime": {"type":"number"},
    "isTradable": {"type":"boolean"},
    "bindOnPickup": {"type":"boolean"},
    "maxStack": {"type":"integer"},
    "tooltip": {"type":"string"},
    "createdAt": {"type":"string","format":"date-time"},
    "lastUpdated": {"type":"string","format":"date-time"},
    "schemaVersion": {"type":"integer"}
  },
  "additionalProperties": false
}
