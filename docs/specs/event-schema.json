{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event Schema",
  "description": "Schema for game events, challenges, and modes",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "description": "Unique event identifier"
    },
    "eventType": {
      "type": "string",
      "enum": ["dailyChallenge", "weeklyChallenge", "allianceEvent", "tournament", "expedition", "sagaStage"],
      "description": "Type of event"
    },
    "name": {
      "type": "string",
      "description": "Event display name"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "startTime": {
      "type": "string",
      "format": "date-time",
      "description": "Event start time"
    },
    "endTime": {
      "type": "string",
      "format": "date-time",
      "description": "Event end time"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["winBattles", "collectResources", "placeBuildings", "reachLevel"],
            "description": "Requirement type"
          },
          "target": {
            "type": "integer",
            "minimum": 1,
            "description": "Target value"
          },
          "progress": {
            "type": "integer",
            "minimum": 0,
            "description": "Current progress"
          }
        },
        "required": ["type", "target"]
      },
      "description": "List of completion requirements"
    },
    "rewards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["card", "resource", "stamina", "gold", "gems", "xp"],
            "description": "Reward type"
          },
          "id": {
            "type": "string",
            "description": "Reward ID (for cards)"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "description": "Reward quantity"
          }
        },
        "required": ["type", "quantity"]
      },
      "description": "List of rewards"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of participating player/alliance IDs"
    },
    "leaderboard": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "playerId": {
            "type": "string",
            "description": "Player ID"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "description": "Score or progress"
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "description": "Current rank"
          }
        },
        "required": ["playerId", "score", "rank"]
      },
      "description": "Event leaderboard"
    },
    "status": {
      "type": "string",
      "enum": ["upcoming", "active", "completed"],
      "description": "Event status"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version"
    }
  },
  "required": ["eventId", "eventType", "name", "description", "startTime", "endTime", "requirements", "rewards", "status", "schemaVersion"]
}