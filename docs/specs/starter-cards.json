  "notes": {
    "designPhilosophy": "3 starter decks ensure meaningful choice without overwhelming new players. Fire (aggro), Water (control), Earth (balanced) teach distinct playstyles.",
    "balanceTargets": {
      "allDecksSameRarityPoints": 31,
      "allDecksSameCardCount": 15,
      "heroStatsVariance": "Fire = high ATK/low DEF, Water = low ATK/high DEF, Earth = balanced"
    },
    "implementationNotes": "Tutorial Step 1: Player chooses 1 of 3 portals. Tutorial Step 2: Player opens Welcome Pack (5 cards, 1 hero guaranteed). Total cards after tutorial: 15 (starter) + 5 (Welcome Pack) = 20 cards."
  }
}
