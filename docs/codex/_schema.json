{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sovereign Territories Card Schema",
  "description": "JSON schema for validating card definitions in the codex",
  "type": "object",
  "required": ["cardId", "collectionNumber", "series", "name", "type", "element", "rarity", "stats"],
  
  "properties": {
    "cardId": {
      "type": "string",
      "pattern": "^(HERO|UNIT|TACTIC|BUILDING)_[A-Z_]+$",
      "description": "Unique identifier (e.g., HERO_ARIA_FLAME_KNIGHT)"
    },
    
    "collectionNumber": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}-[0-9]{3}$",
      "description": "Series collection number (e.g., BS-001)"
    },
    
    "series": {
      "type": "object",
      "required": ["seriesId", "seriesName", "cardNumber", "totalCards"],
      "properties": {
        "seriesId": {"type": "string"},
        "seriesName": {"type": "string"},
        "cardNumber": {"type": "integer", "minimum": 1},
        "totalCards": {"type": "integer", "minimum": 1},
        "releaseDate": {"type": "string", "format": "date"}
      }
    },
    
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 50,
      "description": "Human-readable card name (e.g., Aria, Flame Knight)"
    },
    
    "type": {
      "type": "string",
      "enum": ["Hero", "Unit", "Tactic", "Building"],
      "description": "Card type"
    },
    
    "element": {
      "type": "string",
      "enum": ["Fire", "Water", "Earth", "Lightning", "Wind", "Frost", "Neutral", "Dark", "Light", "Arcane"],
      "description": "Elemental affiliation"
    },
    
    "rarity": {
      "type": "object",
      "required": ["tier", "stars", "points"],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic"]
        },
        "stars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6,
          "description": "Visual star rating (0-6)"
        },
        "points": {
          "type": "integer",
          "enum": [1, 4, 8, 16, 32],
          "description": "Rarity budget cost"
        }
      }
    },
    
    "stats": {
      "type": "object",
      "required": ["health", "mana", "attack", "defense"],
      "properties": {
        "health": {"type": "integer", "minimum": 1, "maximum": 200},
        "mana": {"type": "integer", "minimum": 0, "maximum": 100},
        "attack": {"type": "integer", "minimum": 0, "maximum": 100},
        "defense": {"type": "integer", "minimum": 0, "maximum": 50},
        "moveRange": {"type": "integer", "minimum": 1, "maximum": 8},
        "attackRange": {"type": "integer", "minimum": 1, "maximum": 5},
        "flying": {"type": "boolean"}
      }
    },
    
    "abilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["abilityId", "name", "type", "description"],
        "properties": {
          "abilityId": {"type": "string", "pattern": "^ABILITY_[A-Z_]+$"},
          "name": {"type": "string"},
          "type": {"type": "string", "enum": ["Active", "Passive"]},
          "manaCost": {"type": "integer", "minimum": 0},
          "cooldown": {"type": "integer", "minimum": 0},
          "usesPerBattle": {"type": "integer", "minimum": 1},
          "description": {"type": "string"}
        }
      }
    },
    
    "tacticSlots": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "Number of tactic cards this unit can equip"
    },
    
    "lore": {
      "type": "string",
      "description": "Card backstory/flavor text"
    },
    
    "art": {
      "type": "object",
      "properties": {
        "portraitAsset": {"type": "string"},
        "fullArtAsset": {"type": "string"},
        "shinyPortrait": {"type": "string"},
        "voicelineActor": {"type": "string"}
      }
    },
    
    "gameplay": {
      "type": "object",
      "properties": {
        "tacticSlots": {"type": "integer"},
        "deckBuildingRules": {
          "type": "object",
          "properties": {
            "maxCopies": {"type": "integer"},
            "uniqueHero": {"type": "boolean"}
          }
        }
      }
    },
    
    "acquisition": {
      "type": "object",
      "properties": {
        "packSources": {"type": "array", "items": {"type": "string"}},
        "campaignDrops": {"type": "array", "items": {"type": "string"}},
        "dailyLoginRewards": {"type": "array", "items": {"type": "string"}}
      }
    },
    
    "meta": {
      "type": "object",
      "properties": {
        "designNotes": {"type": "string"},
        "balanceHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {"type": "string", "format": "date"},
              "change": {"type": "string"},
              "author": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
